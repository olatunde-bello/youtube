# Copy this file to .env.local for local development.
# On Vercel, add each of these under Project → Settings → Environment Variables.
# Never commit real values.

# The address your app lives at, with no trailing slash.
# e.g. https://my-youtube-dashboard.vercel.app  (or http://localhost:3000 locally)
APP_URL=

# Who may log in. Comma-separated Google email addresses.
ALLOWED_EMAILS=

# A long random secret (at least 32 characters). Used to sign your login
# cookie and to encrypt YouTube tokens. Changing it later logs you out and
# means every channel must be reconnected.
APP_SECRET=

# Google Cloud → APIs & Services → Credentials → your OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase → Project Settings → API
SUPABASE_URL=
# The "secret" key (sb_secret_...) or the legacy "service_role" key.
# Server-only: it is never sent to the browser.
SUPABASE_SECRET_KEY=
